# ───── 認証ゲート (必須) ─────
# 全 /api/* と全ページに掛かる単一ユーザ共有 token。未設定だと middleware が 503 を返す。
# 生成: openssl rand -base64 32
AUTH_TOKEN=

# ───── DB 暗号化キー (必須) ─────
# DB に保存する OAuth refresh/access token (Google / Spotify) を AES-256-GCM で暗号化する鍵。
# 未設定でも起動はするが、新規 OAuth 連携は失敗する (= encrypt 時に throw)。
# 生成: openssl rand -base64 32  (32 byte / base64 44 char、hex 64 文字も可)
# 鍵を失うと既存の連携トークンは復号不能になり、再連携が必要。
ENCRYPTION_KEY=

# ───── HTTPS / Spotify redirect ─────
# Spotify OAuth redirect URI (= Spotify dashboard に同じ URI を登録する必要あり)。
# Spotify は 2025 以降 loopback の自己署名 HTTPS を "Insecure" として拒否するため、
# 既定は loopback HTTP (= Spotify policy で許可される唯一の loopback 経路)。
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/spotify/callback

# ───── SSRF allowlist (任意) ─────
# 内部 IP / 自宅 LAN / Tailnet / プライベートホストを safeFetch から許可するホスト名
# (comma 区切り)。
# 例: 自宅 LAN の Ollama サーバ "ollama-host"、Tailscale ホスト "llm.tail-net.ts.net" 等。
# user 設定 URL (= AI 設定タブの Local LLM URL / TTS URL / Embed URL) で内部ホストを指す場合、
# その hostname をここに明示登録する必要がある (= 未登録だと safeFetch が private IP として
# 拒否する)。
# SAFE_FETCH_ALLOWED_HOSTS=ollama-host,llm.internal,10.0.0.10

# ───── AI provider 設定は UI 側 (= 設定 → AI タブ) で登録 ─────
# Anthropic / OpenAI / Gemini / Grok API キー、メイン/サブモデル、Embeddings 等は
# 全てブラウザの設定画面から登録できます。.env に書く必要はありません。
# (旧 .env: ANTHROPIC_API_KEY / ANTHROPIC_MODEL / ANTHROPIC_VOICE_MODEL /
#  ANTHROPIC_REPORT_MODEL は廃止 → ai_settings テーブル経由)

# ───── 外部統合の OAuth クライアント (= Google) ─────
# Google OAuth は client_id / secret / redirect_uri が必須 (docs/google-oauth-setup.md 参照)。
# Cloud Console で取得した値を入れる。
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://localhost:8443/api/auth/google/callback
# GCP プロジェクト ID (= NAME ではなく ID。GCP コンソールのプロジェクト一覧の ID 列。
# 例: 名前 "my-tools" → ID "my-tools-496116")。
# X-Goog-User-Project ヘッダや、将来直接 REST 叩く際の billing project 指定に使う。
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# ───── Plane / Spotify client_id / secret 等は UI 側 (= 設定 → 連携タブ) で登録 ─────
# Plane / Spotify アプリ client_id / secret は integration_settings テーブル経由なので
# .env に書かない。

# ───── Discord bot ─────
# Developer Portal で Bot タブから token を取得 (1 回しか見えない)
DISCORD_BOT_TOKEN=your-discord-bot-token
# 自分の Discord User ID (アプリ設定 → 詳細設定 → 開発者モード ON → 自分のアイコン右クリック)
DISCORD_OWNER_ID=000000000000000000
# Discord 専用 session ID (任意 UUID 1 つ固定)。web と分けて memory_chunks に discord 由来を識別させる。
DISCORD_SESSION_ID=00000000-0000-0000-0000-000000000000

# ───── iOS HealthKit Shortcut ─────
# iOS Shortcut → POST /api/health/import の認証ヘッダ用。openssl rand -hex 16 で生成。
HEALTH_INGEST_KEY=

# ───── 任意 / 上級向け ─────
# 朝のブリーフ自動配信時刻 (JST 0-23)。デフォルト 9。
MORNING_CHECK_HOUR_JST=9

# 内部チューニング (= 通常変更不要、code default で十分)
# ANTHROPIC_MAX_TOKENS=400        # 1 ターン上限 token
# CHAT_HISTORY_TURNS=8            # コンテキストに含める履歴数
