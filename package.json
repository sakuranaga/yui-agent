{
  "name": "yui-agent",
  "version": "0.2.0",
  "private": true,
  "description": "3D アバターが声と表情で応答する、個人ホスト向け AI 秘書 (Yui Agent)",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/sakuranaga/yui-agent.git"
  },
  "bugs": {
    "url": "https://github.com/sakuranaga/yui-agent/issues"
  },
  "homepage": "https://github.com/sakuranaga/yui-agent#readme",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "next dev --webpack -H 0.0.0.0",
    "build": "next build --webpack",
    "start": "next start -H 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --incremental false",
    "check": "npm run typecheck && npm run lint && npm run eval:tools",
    "check:tool-model": "npm run eval:gate-llm && npm run eval:executor-llm && npm run eval:tool-orchestrator-llm && npm run eval:dedup-embed",
    "check:tool-integration": "npm run eval:tool-db && npm run eval:tool-reconcile && npm run eval:tool-confirm-phaseb && npm run health:tools && npm run reconcile:tools && npm run eval:tool-domains",
    "check:tool-integration:strict": "npm run eval:tool-db && npm run eval:tool-reconcile && npm run eval:tool-confirm-phaseb && npm run health:tools && npm run reconcile:tools -- --strict && npm run eval:tool-domains:strict",
    "eval:tools": "tsx scripts/tool-runtime-eval.ts",
    "eval:gate-llm": "tsx scripts/tool-gate-llm-eval.ts",
    "eval:executor-llm": "tsx scripts/tool-executor-llm-eval.ts",
    "eval:tool-orchestrator-llm": "tsx scripts/tool-orchestrator-llm-eval.ts",
    "eval:dedup-embed": "tsx scripts/tool-dedup-embedding-eval.ts",
    "eval:tool-db": "tsx scripts/tool-db-integration-eval.ts",
    "eval:tool-reconcile": "tsx scripts/tool-reconciliation-eval.ts",
    "eval:tool-confirm-phaseb": "tsx scripts/tool-confirm-phaseb-eval.ts",
    "eval:tool-domains": "TOOL_DOMAIN_EVAL_ALLOW_EXTERNAL_SKIP=1 tsx scripts/tool-domain-integration-eval.ts",
    "eval:tool-domains:strict": "tsx scripts/tool-domain-integration-eval.ts",
    "health:tools": "tsx scripts/tool-db-health-check.ts",
    "observe:tools": "tsx scripts/tool-observability-report.ts",
    "reconcile:tools": "tsx scripts/tool-reconciliation-report.ts",
    "db:migrate": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.40.1",
    "@modelcontextprotocol/sdk": "1.26.0",
    "@monyone/aho-corasick": "1.1.11",
    "@pixiv/three-vrm": "3.5.3",
    "@pixiv/three-vrm-animation": "3.5.3",
    "drizzle-orm": "0.45.2",
    "ioredis": "5.11.0",
    "isomorphic-dompurify": "3.16.0",
    "jose": "6.2.3",
    "mcp-handler": "1.1.0",
    "next": "16.2.7",
    "pg": "8.21.0",
    "postgres": "3.4.9",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-markdown": "9.1.0",
    "remark-gfm": "4.0.1",
    "rss-parser": "3.13.0",
    "three": "0.171.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.5",
    "@types/node": "22.19.19",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.171.0",
    "drizzle-kit": "0.28.1",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.7",
    "tsx": "4.22.3",
    "typescript": "5.9.3"
  }
}
